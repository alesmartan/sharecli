// Local development only (`pnpm dev`). Real deployments are generated by `share setup`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sharecli-dev",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "dist/worker/assets", "binding": "ASSETS" },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "sharecli-dev" }],
  "d1_databases": [{ "binding": "DB", "database_name": "sharecli-dev", "database_id": "00000000-0000-0000-0000-000000000000" }],
  "triggers": { "crons": ["17 * * * *"] },
  "vars": { "DEFAULT_TTL_DAYS": "30" }
}
